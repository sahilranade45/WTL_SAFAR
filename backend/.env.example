# ─────────────────────────────────────────────────────────────────────────────
# SAFAR Backend — Environment Variables
# Copy this file to ".env" and fill in your values.
# NEVER commit ".env" to Git — it contains secrets!
# ─────────────────────────────────────────────────────────────────────────────

# Required: Your Google Gemini API key
# Get one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model to use (defaults to gemini-2.0-flash if not set)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Comma-separated list of frontend origins allowed to call this API.
# Add your frontend's URL if it differs from the defaults below.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000
