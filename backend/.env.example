# SAFAR backend settings.
# 1. Copy this file and name the copy ".env"  (the real .env is ignored by Git)
# 2. Put your own values after the = signs. Never share or commit the real .env.

# Required. Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=paste_your_key_here

# Optional. Which Gemini model to use (default is gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash-lite
